# Copy to .env for local runs (never commit real values). On Render these are set in the dashboard.
# Database: Postgres URL (Render / Neon / any). Leave empty locally to use SQLite (./p2_local.db).
DATABASE_URL=
# Admin / master API key (Render generates it in env group mosje-p2-shared)
P2_API_KEY=change-me-admin-key
# Optional: one key per Product 1 system -> tenant isolation. Format source:key,source:key
P2_API_KEYS=p1-rajat:change-me-key-1,p1-teamB:change-me-key-2
# WhatsApp (Meta Cloud API). App works without these; replies are then only logged.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# The WhatsApp number users chat with (digits, with country code) - used in wa.me links.
# If empty, it is learned from the first webhook Meta sends.
WHATSAPP_DISPLAY_NUMBER=
# Optional
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_INVITE_TEMPLATE=hello_world
WHATSAPP_INVITE_TEMPLATE_LANG=en_US
# Web companion
ALLOWED_ORIGINS=
COMPANION_PUBLIC=true
# Public https URL of this service, used in generated links. On Render it defaults to RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=
P2_MAX_RESULTS=5
LOG_LEVEL=INFO
